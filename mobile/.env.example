EXPO_PUBLIC_API_URL=http://localhost:5000

# Same Web OAuth client ID as the API GoogleSignIn__ClientId.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: required only for an iOS build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Browser API URL; keep the LAN API URL above for physical phones.
EXPO_PUBLIC_WEB_API_URL=http://localhost:5106
# Number of lessons on each page (1-50).
EXPO_PUBLIC_LESSONS_PAGE_SIZE=4
