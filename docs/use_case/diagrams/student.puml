@startuml
title Use Case Diagram - Student

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "User" as User
actor "Student" as Student

User <|-- Student

rectangle "Tutoring Management System" {
  package "Common User Goals" {
    usecase "Access my\naccount" as UC_ACCOUNT
    usecase "Manage my\nprofile" as UC_PROFILE
    usecase "Use the mobile\napplication" as UC_MOBILE
    usecase "Receive important\nreminders" as UC_NOTIFICATIONS
    usecase "Use the application\nwithout ads" as UC_NO_ADS
  }

  package "P1 - Core Goals" {
    usecase "Know my lesson\nschedule" as UC_LESSON_PLAN
    usecase "Use learning\nmaterials" as UC_USE_MATERIALS
    usecase "Control my\npayments" as UC_PAYMENTS
    usecase "Track my own\nprogress" as UC_PROGRESS
  }

  package "P2 - Optional Goals" {
    usecase "Pay for lessons\nonline" as UC_ONLINE_PAYMENT
    usecase "Submit homework" as UC_SUBMIT_HOMEWORK
    usecase "Work together on\na whiteboard" as UC_WHITEBOARD
    usecase "Attend a lesson\nonline" as UC_VIDEO_LESSON
    usecase "Remember overdue\npayments" as UC_PAYMENT_REMINDER
  }

  package "P3 - Future Goals" {
    usecase "Return to lesson\nrecordings" as UC_RECORDINGS
    usecase "Use a text record\nof a lesson" as UC_TRANSCRIPTION
  }
}

User -- UC_ACCOUNT
User -- UC_PROFILE
User -- UC_MOBILE
User -- UC_NOTIFICATIONS
User -- UC_NO_ADS

Student -- UC_LESSON_PLAN
Student -- UC_USE_MATERIALS
Student -- UC_PAYMENTS
Student -- UC_PROGRESS
Student -- UC_ONLINE_PAYMENT
Student -- UC_SUBMIT_HOMEWORK
Student -- UC_WHITEBOARD
Student -- UC_VIDEO_LESSON
Student -- UC_PAYMENT_REMINDER
Student -- UC_RECORDINGS
Student -- UC_TRANSCRIPTION

UC_ONLINE_PAYMENT ..> UC_PAYMENTS : <<extend>>
UC_PAYMENT_REMINDER ..> UC_NOTIFICATIONS : <<extend>>
UC_TRANSCRIPTION ..> UC_RECORDINGS : <<extend>>

note bottom of UC_LESSON_PLAN
  This diagram describes what the student
  wants to achieve: know the schedule,
  learn from materials, submit homework,
  and control payments.
end note

@enduml
