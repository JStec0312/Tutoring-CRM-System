@startuml
title Use Case Diagram - User

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "User" as User

rectangle "Tutoring Management System" {
  package "P1 - Core Goals" {
    usecase "Access my\naccount" as UC_ACCOUNT
    usecase "Manage my\nprofile" as UC_PROFILE
    usecase "Use the mobile\napplication" as UC_MOBILE
    usecase "Receive important\nreminders" as UC_NOTIFICATIONS
  }

  package "P3 - Future Goals" {
    usecase "Use the application\nwithout ads" as UC_NO_ADS
  }
}

User -- UC_ACCOUNT
User -- UC_PROFILE
User -- UC_MOBILE
User -- UC_NOTIFICATIONS
User -- UC_NO_ADS

note bottom of UC_ACCOUNT
  Use cases describe actor goals,
  not screens, buttons, forms,
  or technical system logic.
end note

@enduml
