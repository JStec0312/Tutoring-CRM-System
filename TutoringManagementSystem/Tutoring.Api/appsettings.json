{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\TutoringLocalDb;Database=TutoringDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "https": {
    "commandName": "Project",
    "dotnetRunMessages": true,
    "launchBrowser": true,
    "launchUrl": "scalar",
    "applicationUrl": "https://localhost:7219;http://localhost:5106",
    "environmentVariables": {
      "ASPNETCORE_ENVIRONMENT": "Development"
    }
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "MaximumLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true
  },
  "Jwt": {
    "Issuer": "TutoringCrmSystem",
    "Audience": "TutoringCrmSystem.Client",
    "SecretKey": "CHANGE_ME_dev-only-placeholder-secret-use-user-secrets-or-env-vars-in-production",
    "ExpirationMinutes": 30
  },
  "RefreshToken": {
    "ExpirationDays": 30
  }
}
